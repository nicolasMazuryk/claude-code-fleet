{
  "plugins": ["warp", "mac-control-router"],
  "permissions": [
    "Bash(mac-control-router *)",
    "Bash(peekaboo *)",
    "Bash(osascript *)",
    "Bash(shortcuts *)",
    "Bash(mdfind *)",
    "Bash(mdls *)",
    "Bash(open -g *)",
    "Bash(open -g x-apple.systempreferences:*)",
    "Bash(open -a *)",
    "Bash(open -ga *)",
    "Bash(open x-apple.systempreferences:*)",
    "Bash(killall Dock)",
    "Bash(killall Finder)",
    "Bash(killall SystemUIServer)",
    "Bash(killall ControlCenter)",
    "Bash(defaults write com.apple.dock *)",
    "Bash(cliclick *)",
    "Bash(trash *)",
    "Bash(lsappinfo *)",
    "Bash(defaults read *)",
    "Bash(sudo *)",
    "Bash(csrutil *)",
    "Bash(csrutil disable*)",
    "Bash(csrutil clear*)",
    "Bash(csrutil enable*)",
    "Bash(tccutil *)",
    "Bash(nvram *)",
    "Bash(nvram -c*)",
    "Bash(nvram -d *)",
    "Bash(nvram *=*)",
    "Bash(fdesetup *)",
    "Bash(fdesetup enable*)",
    "Bash(fdesetup disable*)",
    "Bash(fdesetup changerecovery*)",
    "Bash(fdesetup removerecovery*)",
    "Bash(peekaboo agent *)",
    "mcp__computer-use"
