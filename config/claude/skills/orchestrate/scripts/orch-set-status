#!/usr/bin/env bash
# orch-set-status <run-dir> <job> <state> "<step>" ["<needs_input>"] — write jobs/<job>/status.json, keep other fields.
# states: queued running blocked ready_for_verify verify_pass verify_fail done failed
set -euo pipefail
[ $# -ge 4 ] || { echo "usage: orch-set-status <run-dir> <job> <state> <step> [needs_input]" >&2; exit 2; }
run=$1 job=$2 state=$3 step=$4 need=${5:-}
case $state in queued|running|blocked|ready_for_verify|verify_pass|verify_fail|done|failed) ;;
  *) echo "orch-set-status: bad state '$state'" >&2; exit 2 ;; esac
d="$run/jobs/$job"; f="$d/status.json"; mkdir -p "$d"
[ -s "$f" ] || echo "{\"job\":\"$job\"}" >"$f"
tmp=$(mktemp "$d/.status.XXXXXX")
jq --arg s "$state" --arg st "$step" --arg n "$need" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  '.state=$s | .step=$st | .needs_input=(if $n == "" then null else $n end) | .updated_at=$t' "$f" >"$tmp"
mv "$tmp" "$f"
