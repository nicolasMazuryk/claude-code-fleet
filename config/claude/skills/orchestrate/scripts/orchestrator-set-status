#!/usr/bin/env bash
# orchestrator-set-status <run-dir> <job> <state> "<step>" ["<needs_input>"] [--field key=value]... — write
# jobs/<job>/status.json, keep other fields. --field sets an extra string field (e.g. merged_sha=<sha>).
# states: queued planning plan_ready plan_approved running blocked ready_for_verify verify_pass verify_fail done failed
set -euo pipefail
usage() { echo "usage: orchestrator-set-status <run-dir> <job> <state> <step> [needs_input] [--field key=value]..." >&2; exit 2; }
pos=() extra='' n=0 jqargs=()
while [ $# -gt 0 ]; do
  if [ "$1" = --field ]; then
    [ $# -ge 2 ] && [[ $2 == ?*=* ]] || usage
    k=${2%%=*}; [[ $k =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || usage
    jqargs+=(--arg "k$n" "$k" --arg "v$n" "${2#*=}"); extra="$extra | .[\$k$n]=\$v$n"; n=$((n + 1)); shift 2
  else pos+=("$1"); shift; fi
done
[ ${#pos[@]} -ge 4 ] && [ ${#pos[@]} -le 5 ] || usage
run=${pos[0]} job=${pos[1]} state=${pos[2]} step=${pos[3]} need=${pos[4]:-}
case $state in queued|planning|plan_ready|plan_approved|running|blocked|ready_for_verify|verify_pass|verify_fail|done|failed) ;;
  *) echo "orchestrator-set-status: bad state '$state'" >&2; exit 2 ;; esac
d="$run/jobs/$job"; f="$d/status.json"; mkdir -p "$d"
[ -s "$f" ] || echo "{\"job\":\"$job\"}" >"$f"
tmp=$(mktemp "$d/.status.XXXXXX")
jq --arg s "$state" --arg st "$step" --arg n "$need" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" ${jqargs[@]+"${jqargs[@]}"} \
  ".state=\$s | .step=\$st | .needs_input=(if \$n == \"\" then null else \$n end) | .updated_at=\$t$extra" "$f" >"$tmp"
mv "$tmp" "$f"
