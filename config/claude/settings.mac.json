{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_REMOTE_CONTROL_SESSION_NAME_PREFIX": "mac"
  },
  "permissions": {
    "allow": [
      "Bash(gh repo create:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo rename:*)",
      "Bash(git -C * push:*)",
      "Bash(git push:*)",
      "mcp__plugin_playwright_playwright__*"
    ]
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -e '((.background_tasks // []) + (.session_crons // [])) | length == 0' >/dev/null && afplay ~/.claude/sounds/choo-choo.mp3 || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/.claude/sounds/choo-choo.mp3"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/.claude/sounds/choo-choo.mp3"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/.claude/sounds/choo-choo.mp3"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-combined.sh",
    "padding": 0,
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "claude-hud@claude-hud": true,
    "cowork-plugin-management@synced": false
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "feedbackDrafts": "notify",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "timeFormat": "24-hour",
  "autoMemoryEnabled": true,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false
}
