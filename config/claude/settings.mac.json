{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_REMOTE_CONTROL_SESSION_NAME_PREFIX": "mac"
  },
  "permissions": {
    "allow": [
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo rename:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(make apply-*)",
      "Bash(make host-sync*)",
      "mcp__ccd_session_mgmt__export_transcript",
      "mcp__ccd_session_mgmt__get_session",
      "mcp__ccd_session_mgmt__list_events",
      "mcp__ccd_session_mgmt__list_sessions",
      "mcp__ccd_session_mgmt__search_session_transcripts",
      "mcp__plugin_playwright_playwright__*",
      "Read(//Users/nicolas/code/orchestrator-runs/**)",
      "Edit(//Users/nicolas/code/orchestrator-runs/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -e '((.background_tasks // []) + (.session_crons // [])) | length == 0' >/dev/null && afplay ~/.claude/sounds/choo-choo.mp3 || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/browser-guard"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/.claude/sounds/choo-choo.mp3"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/.claude/sounds/choo-choo.mp3"
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/browser-guard"
          }
        ]
      },
      {
        "matcher": "mcp__computer-use__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/browser-guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/browser-guard"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/.claude/sounds/choo-choo.mp3"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "browser-router-relay",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/libexec/cc-orchestrator/browser-relay-handler"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-env.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__claude-in-chrome__(tabs_create_mcp|tabs_close_mcp|tabs_context_mcp|navigate)",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/browser-guard"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-combined.sh",
    "padding": 0,
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "claude-hud@claude-hud": true,
    "cowork-plugin-management@synced": false
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "outputStyle": "Proactive",
  "feedbackDrafts": "notify",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "timeFormat": "24-hour",
  "autoMemoryEnabled": true,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false
}
