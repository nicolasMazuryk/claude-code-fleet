# cc-egress — the egress gateway stack (config/cloud/egress/compose.yaml): tailscale sidecar `egress` (tag:egress),
# nftables guard, gost on host :8443. Installed by ./install.sh cloud; started only once the proxy password was delivered.
[Unit]
Description=Egress gateway: tailscale + guard + gost (cc-orchestrator)
After=docker.service network-online.target data.mount
Requires=docker.service
RequiresMountsFor=/data

[Service]
Type=oneshot
RemainAfterExit=yes
User=agent
Group=docker
WorkingDirectory=/data/home/agent/claude-code-fleet/config/cloud/egress
Environment=EGRESS_STATE_DIR=/data/home/agent/.local/state/egress/tailscale
Environment=EGRESS_SECRETS_DIR=/data/home/agent/.config/egress
ExecStartPre=/bin/sh -c 'test -s "$EGRESS_SECRETS_DIR/tls/key.pem" || echo "cc-egress: WARNING no TLS certificate in $EGRESS_SECRETS_DIR/tls: gost serves a self-signed one (run bin/egress-cert-renew on the Mac)"'
ExecStart=/usr/bin/docker compose up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
