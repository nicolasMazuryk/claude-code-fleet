<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by install.sh mac (@HOME@, @TMUX@ → real paths). At login: Agent View (tmux "agents") + RC servers
     (tmux "rc"). launchd execs tmux itself, which runs cc-orchestrator-start inside the tmux server (short-lived
     session "cc-start"): the scripts live in ~/Documents (TCC-protected), so only tmux needs Full Disk Access. -->
<plist version="1.0"><dict>
  <key>Label</key><string>cc-orchestrator.claude.agents</string>
  <key>ProgramArguments</key><array>
    <string>@TMUX@</string><string>-u</string><string>new-session</string><string>-d</string>
    <string>-s</string><string>cc-start</string><string>@HOME@/.local/bin/cc-orchestrator-start</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>/tmp/cc-orchestrator-start.log</string>
  <key>StandardErrorPath</key><string>/tmp/cc-orchestrator-start.log</string>
</dict></plist>
