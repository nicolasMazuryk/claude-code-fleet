<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by install.sh mac (@HOME@ → real home). Agent View (tmux "agents") + RC servers (tmux "rc") at login. -->
<plist version="1.0"><dict>
  <key>Label</key><string>cc-orchestrator.claude.agents</string>
  <key>ProgramArguments</key><array><string>@HOME@/.local/bin/cc-orchestrator-start</string></array>
  <key>RunAtLoad</key><true/>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>/tmp/cc-orchestrator-start.log</string>
  <key>StandardErrorPath</key><string>/tmp/cc-orchestrator-start.log</string>
</dict></plist>
