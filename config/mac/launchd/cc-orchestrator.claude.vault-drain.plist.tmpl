<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by install.sh mac (@HOME@ → real home). The Mac's browser-router vault queue drain, same semantics as the
     cloud timer: every 180 s `browser-router vault drain` starts at most one runnable job. Runs the copy in
     ~/.local/libexec/cc-orchestrator: launchd jobs cannot read ~/Documents (TCC). -->
<plist version="1.0"><dict>
  <key>Label</key><string>cc-orchestrator.claude.vault-drain</string>
  <key>ProgramArguments</key><array><string>@HOME@/.local/libexec/cc-orchestrator/browser-vault-drain</string></array>
  <key>StartInterval</key><integer>180</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/browser-vault-drain.log</string>
  <key>StandardErrorPath</key><string>/tmp/browser-vault-drain.log</string>
</dict></plist>
