<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by install.sh mac (@HOME@ → real home). Cloud sound relay + presence beacon (bin/agent-relay, Phase 5). -->
<plist version="1.0"><dict>
  <key>Label</key><string>cc-orchestrator.claude.relay</string>
  <key>ProgramArguments</key><array><string>@HOME@/.local/bin/agent-relay</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardErrorPath</key><string>/tmp/agent-relay.log</string>
</dict></plist>
