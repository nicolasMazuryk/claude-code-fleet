<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by install.sh mac (@HOME@ → real home). Daily 10:30 (and at load): issue/renew the egress gateway
     certificate and push it to cloud (bin/egress-cert-renew). Runs the copy in ~/.local/libexec/cc-orchestrator:
     launchd jobs cannot read ~/Documents (TCC). A missing Keychain token or lego makes it log and exit 0. -->
<plist version="1.0"><dict>
  <key>Label</key><string>cc-orchestrator.claude.egress-cert</string>
  <key>ProgramArguments</key><array><string>@HOME@/.local/libexec/cc-orchestrator/egress-cert-renew</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/tmp/egress-cert-renew.log</string>
  <key>StandardErrorPath</key><string>/tmp/egress-cert-renew.log</string>
</dict></plist>
