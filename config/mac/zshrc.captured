# Captured from ~/.zshrc by cc-capture (blocks: # Claude Code, # Tailscale…). Reference, not sourced.

# Tailscale exit node: `browser-router exit-node use <macbook|iphone|cloud|static-ip|none> [--for self|egress]`
# (replaces the former staticipup/staticipdown aliases)

# Claude Code
alias c='claude'
alias cc='claude --continue'
alias ca='claude agents'
cw()  { claude --worktree "$@"; }                 # cw feature-x
cbg() { claude --bg --name "$1" "${@:2}"; }       # cbg flaky-fix "investigate…"
