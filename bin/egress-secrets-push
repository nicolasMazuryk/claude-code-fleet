#!/usr/bin/env bash
# egress-secrets-push — Mac → cloud delivery of the egress gateway secrets (run by ./install.sh cloud; Mac only).
# Cloud cannot read the proxy password from Vault (OCI IAM option B), so the Mac opens the ssh and pipes it over stdin:
#   Keychain cc-egress-proxy-password → cloud ~/.config/egress/gost-auth    "browseruse <password>", 0400, uid 10001
#   Keychain cc-egress-ts-authkey     → cloud ~/.config/egress/ts-authkey   0600, optional (first join of node `egress`)
# Add to the Keychain once (the same password as the Vault secret of the proxy):
#   security add-generic-password -U -s cc-egress-proxy-password -a "$USER" -w
# It also builds the browser-router env file (KEY=VALUE, 0600) from the Keychain and writes it to cloud
# ~/.config/browser-router/env (agent user) and, with --local, to the Mac's own ~/.config/browser-router/env:
#   cc-browser-use-api-key → BROWSER_USE_API_KEY     cc-egress-public-host → BROWSER_ROUTER_EGRESS_HOST (core-nlb IP/DNS, G3)
#   cc-egress-proxy-password → BROWSER_ROUTER_EGRESS_PASSWORD     constants: _PORT 8443, _USER browseruse
# A missing Keychain item skips that key with a log line; it never fails. No key at all → no file written.
# Idempotent: compares the sha256 on cloud first, writes only when different. Values never appear in argv or output.
# Usage: egress-secrets-push [--dry-run] [--local]  (--local: only the Mac env file, used by install.sh mac).
# Test hooks: CC_CLOUD_HOST (default cloud), CC_EGRESS_USER (default browseruse), CC_EGRESS_PORT (default 8443).
set -euo pipefail
h=${CC_CLOUD_HOST:-cloud}; user=${CC_EGRESS_USER:-browseruse}; port=${CC_EGRESS_PORT:-8443}; dry=0; local_only=0
for a in "$@"; do case $a in --dry-run) dry=1 ;; --local) local_only=1 ;; esac; done
changed=0

kc() { security find-generic-password -s "$1" -a "$USER" -w 2>/dev/null || true; }

env_content() { # prints the env file; logs (stderr) each skipped key
  local v
  v=$(kc cc-browser-use-api-key)
  if [ -n "$v" ]; then printf 'BROWSER_USE_API_KEY=%s\n' "$v"; else printf '  %-9s %s\n' egress "skip BROWSER_USE_API_KEY: no Keychain item cc-browser-use-api-key" >&2; fi
  v=$(kc cc-egress-public-host)
  if [ -n "$v" ]; then printf 'BROWSER_ROUTER_EGRESS_HOST=%s\nBROWSER_ROUTER_EGRESS_PORT=%s\nBROWSER_ROUTER_EGRESS_USER=%s\n' "$v" "$port" "$user"
  else printf '  %-9s %s\n' egress "skip BROWSER_ROUTER_EGRESS_HOST/PORT/USER: no Keychain item cc-egress-public-host" >&2; fi
  v=$(kc cc-egress-proxy-password)
  if [ -n "$v" ]; then printf 'BROWSER_ROUTER_EGRESS_PASSWORD=%s\n' "$v"; else printf '  %-9s %s\n' egress "skip BROWSER_ROUTER_EGRESS_PASSWORD: no Keychain item cc-egress-proxy-password" >&2; fi
}

push_env() { # push_env <local|cloud>
  local where=$1 content lhash rhash f
  content=$(env_content)
  if [ -z "$content" ]; then printf '  %-9s %s\n' egress "no browser-router env keys in the Keychain; $where env not written"; return 0; fi
  lhash=$(printf '%s\n' "$content" | shasum -a 256 | cut -c1-64)
  if [ "$where" = local ]; then
    f="$HOME/.config/browser-router/env"
    rhash=$(shasum -a 256 < "$f" 2>/dev/null | cut -c1-64 || true)
  else
    # shellcheck disable=SC2016
    rhash=$(ssh -o BatchMode=yes "$h" 'sha256sum ~/.config/browser-router/env 2>/dev/null | cut -c1-64' || true)
  fi
  if [ "$lhash" = "$rhash" ]; then printf '  %-9s %s\n' egress "ok $where browser-router env"; return 0; fi
  if [ "$dry" = 1 ]; then printf '  %-9s %s\n' egress "would write the $where browser-router env"; return 0; fi
  if [ "$where" = local ]; then
    ( umask 077; mkdir -p "${f%/*}"; printf '%s\n' "$content" > "$f.tmp" ); chmod 600 "$f.tmp"; mv "$f.tmp" "$f"
  else
    # shellcheck disable=SC2016
    printf '%s\n' "$content" | ssh -o BatchMode=yes "$h" 'umask 077; d=$HOME/.config/browser-router; mkdir -p "$d" && cat > "$d/env.tmp" && chmod 600 "$d/env.tmp" && mv "$d/env.tmp" "$d/env"'
  fi
  printf '  %-9s %s\n' egress "wrote $where browser-router env (0600)"
}

if [ "$local_only" = 1 ]; then push_env local; exit 0; fi

push() { # push <keychain service> <remote file> <owner:group> <mode> <prefix to the secret>
  local svc=$1 file=$2 owner=$3 mode=$4 prefix=$5 val lhash rhash
  if ! val=$(security find-generic-password -s "$svc" -a "$USER" -w 2>/dev/null) || [ -z "$val" ]; then
    printf '  %-9s %s\n' egress "WARNING: no Keychain item $svc; $file not delivered"; return 0
  fi
  lhash=$(printf '%s%s\n' "$prefix" "$val" | shasum -a 256 | cut -c1-64)
  # shellcheck disable=SC2016
  rhash=$(ssh -o BatchMode=yes "$h" "sudo sha256sum ~/.config/egress/$file 2>/dev/null | cut -c1-64" || true)
  if [ "$lhash" = "$rhash" ]; then printf '  %-9s %s\n' egress "ok $h:~/.config/egress/$file"; return 0; fi
  changed=1
  if [ "$dry" = 1 ]; then printf '  %-9s %s\n' egress "would deliver $file to $h"; return 0; fi
  # shellcheck disable=SC2016
  printf '%s%s\n' "$prefix" "$val" | ssh -o BatchMode=yes "$h" "umask 077; d=\$HOME/.config/egress; mkdir -p \"\$d\" && chmod 700 \"\$d\" && sudo tee \"\$d/$file.tmp\" >/dev/null && sudo chown $owner \"\$d/$file.tmp\" && sudo chmod $mode \"\$d/$file.tmp\" && sudo mv \"\$d/$file.tmp\" \"\$d/$file\""
  printf '  %-9s %s\n' egress "delivered $file to $h ($mode)"
}

push cc-egress-proxy-password gost-auth 10001:10001 0400 "$user "
push cc-egress-ts-authkey ts-authkey agent:agent 0600 ""
push_env cloud
[ "$changed" = 1 ] && [ "$dry" = 0 ] && printf '  %-9s %s\n' egress "restart the stack to pick them up: ssh $h sudo systemctl restart cc-egress"
exit 0
