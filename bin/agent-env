#!/usr/bin/env bash
# agent-env — SOURCED (not executed) by cc-orchestrator scripts: tools on PATH, UTF-8, node, per-machine config.
#   Mac: node via nvm's default alias (~/.nvm). cloud: system node (NodeSource), no manager.
#   Config: ~/.config/cc-orchestrator/config (written by install.sh); CC_ORCH_CONFIG overrides it (tests).
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
if [ "$(uname)" = Darwin ]; then
  export LANG=${LANG:-en_US.UTF-8}
  export NVM_DIR=${NVM_DIR:-$HOME/.nvm}
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    # nvm.sh is not set -u safe; callers may have it on
    case $- in *u*) _agent_env_u=1; set +u ;; *) _agent_env_u= ;; esac
    # shellcheck disable=SC1091
    . "$NVM_DIR/nvm.sh" --no-use && nvm use --silent default >/dev/null 2>&1
    [ -n "$_agent_env_u" ] && set -u
    unset _agent_env_u
  fi
else
  export LANG=${LANG:-C.UTF-8}
fi
# shellcheck disable=SC1090
. "${CC_ORCH_CONFIG:-$HOME/.config/cc-orchestrator/config}"
: "${AGENTS_ROOT:?set AGENTS_ROOT in ~/.config/cc-orchestrator/config}" "${AGENT_HOST:?set AGENT_HOST}"
