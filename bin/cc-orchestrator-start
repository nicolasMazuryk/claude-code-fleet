#!/usr/bin/env bash
# cc-orchestrator-start (Mac; run at login by LaunchAgent cc-orchestrator.claude.agents) — idempotent:
# Agent View in tmux session $AGENTS_SESSION, then one Remote Control server per allowlisted repo (rc-servers).
# Cloud uses systemd (cc-agents.service, cc-rc@.service) instead.
# shellcheck source=bin/agent-env
. "$HOME/.local/bin/agent-env"
tmux -u has-session -t "=$AGENTS_SESSION" 2>/dev/null ||
  tmux -u new-session -d -s "$AGENTS_SESSION" "$HOME/.local/bin/agents-loop"
exec "$HOME/.local/bin/rc-servers"
